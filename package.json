
{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "Browser test automation with Playwright and JavaScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report reports",
    "test:chromium": "playwright test --project=chromium",
    "test:ci": "playwright test --project=chromium",
    "install:browsers": "playwright install chromium",
    "ci:install": "npm ci && playwright install --with-deps chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3"
  }
}
